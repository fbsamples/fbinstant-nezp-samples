<View className="results">
    <If>
        <Condition lhs="{{outcome}}" operator="EQUALS" rhs="win"/>
        <View><Text className="headline" content="You win!"/></View>
        <ElseIf>
            <Condition lhs="{{outcome}}" operator="EQUALS" rhs="lose"/>
            <View><Text className="headline" content="{{FBInstant.players[{{winnerID}}].name}} wins"/></View>
        </ElseIf>
        <ElseIf>
            <Condition lhs="{{outcome}}" operator="EQUALS" rhs="tie"/>
            <View><Text className="headline" content="Tied for first"/></View>
        </ElseIf>
        <Else>
            <View><Text className="headline" content="{{waitingText}}"/></View>
        </Else>
    </If>
    <View className="result-row">
        <Image className="avatar" src="{{FBInstant.player.photo}}" width="56" height="56"/>
        <Text className="result-name" content="{{FBInstant.player.name}}"/>
        <Text className="result-score" content="{{myScore}}"/>
    </View>
    <For source="{{standings}}" itemName="r" limit="5">
        <View className="result-row">
            <Image className="avatar" src="{{FBInstant.players[{{r.id}}].photo}}" width="56" height="56"/>
            <Text className="result-name" content="{{FBInstant.players[{{r.id}}].name}}"/>
            <If>
                <Condition lhs="{{r.played}}" operator="EQUALS" rhs="yes"/>
                <View><Text className="result-score" content="{{r.score}}"/></View>
                <Else>
                    <View><Text className="result-score result-pending" content="-"/></View>
                </Else>
            </If>
        </View>
    </For>
</View>
